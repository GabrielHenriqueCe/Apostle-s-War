<Project Sdk="Microsoft.NET.Sdk">

  <!-- CASCA EXECUTÁVEL (a única parte amarrada ao Windows). É aqui que mora o composition root
       (Program.cs) e o front webview. O TFM é net10.0-windows porque o WebView2 exige WinForms
       pra hospedar o controle; o MOTOR (ApostlesWar) segue net10.0 puro e portátil.
       Publicação: `dotnet publish -c Release -r win-x64` self-contained → .exe pro GitHub Releases. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ApostlesWar.Presentation</RootNamespace>
    <AssemblyName>ApostlesWar.App</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Composition root: o ÚNICO projeto que enxerga todas as camadas — é aqui que os fios são
         ligados (Program.cs). Referenciar Infrastructure é a "impureza" permitida do modelo. -->
    <ProjectReference Include="..\ApostlesWar.Domain\ApostlesWar.Domain.csproj" />
    <ProjectReference Include="..\ApostlesWar.Application\ApostlesWar.Application.csproj" />
    <ProjectReference Include="..\ApostlesWar.Infrastructure\ApostlesWar.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
  </ItemGroup>

  <!-- O pacote do WebView2 referencia as variantes WinForms E WPF sem condição (ver
       build/Common.targets do pacote). A WPF arrasta outro WindowsBase e gera MSB3277. Como esta
       casca é WinForms-only, a referência WPF é morta: removemos em vez de silenciar o aviso.
       Precisa ser num Target porque os targets do pacote são importados DEPOIS do corpo do csproj. -->
  <Target Name="RemoverReferenciaWpfDoWebView2" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- A "pele" do front (HTML/CSS/JS) mora no repo e é copiada pra saída, ao lado do .exe.
         PreserveNewest permite iterar na tela sem rebuild completo. -->
    <None Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- NÃO existe semente de save. Houve uma (`..\Save\**` copiada pra saída), versionada e "com tudo
       liberado" pra encurtar o teste — e ela QUEBRAVA o excluir conta: o wipe apagava os arquivos da
       saída e o build seguinte repunha `save.txt`/`itens.txt` do repo, então o jogador recomeçava com
       os 36 apostolos e os itens de volta. Removida em jul/2026.

       O jogo boota liso sem arquivo nenhum: a porta devolve default e cada service fica no estado
       inicial (Reino fase 1, os 4 Humanos, slots vazios). "Jogo novo" é a AUSÊNCIA de save, não um
       save especial — e é essa a única definição que o excluir conta consegue reproduzir. -->

</Project>
